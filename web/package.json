{
  "name": "mostfundable-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/ts-resolve-hook.mjs --test --test-reporter=tap 'src/**/*.test.ts'",
    "test:hardening": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/ts-resolve-hook.mjs --test --test-reporter=tap 'tests/hardening/**/*.test.ts' 'src/lib/billing/operator-ladder.property.test.ts' 'tests/hardening/**/*.test.mjs'",
    "test:watch": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/ts-resolve-hook.mjs --test --test-reporter=tap --watch 'src/**/*.test.ts'",
    "test:e2e": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/ts-resolve-hook.mjs --test --test-reporter=tap 'tests/e2e/**/*.test.ts'",
    "test:gates": "node scripts/verify-feedback-fixtures.mjs && node scripts/verify-compliance-copy.mjs && node scripts/verify-no-auto-send.mjs --self-test && node scripts/verify-no-auto-send.mjs && node scripts/verify-ai-transport.mjs --self-test && node scripts/verify-ai-transport.mjs && node scripts/verify-alert-batch-load.mjs --self-test && ! node scripts/verify-alert-batch-load.mjs --profile ../docs/handover/alert-load-profile.json && node scripts/verify-secret-hygiene.mjs --self-test && node scripts/verify-security-headers.mjs --self-test && node scripts/verify-rls-matrix.mjs --inventory && node scripts/verify-seed-repeatable.mjs && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/ts-resolve-hook.mjs --test src/lib/ancillary/report-uploads.test.ts src/lib/ancillary/purge.test.ts",
    "verify:ai-transport": "node scripts/verify-ai-transport.mjs --self-test && node scripts/verify-ai-transport.mjs",
    "verify:alert-load": "node scripts/verify-alert-batch-load.mjs --self-test",
    "verify:secret-hygiene": "node scripts/verify-secret-hygiene.mjs --repo .. --build-dir .next",
    "verify:security-headers": "node scripts/verify-security-headers.mjs --self-test",
    "verify:rls-matrix": "node scripts/verify-rls-matrix.mjs --inventory",
    "verify:live": "node scripts/verify-tracker-live.mjs",
    "demo:reset": "cd .. && supabase db reset --local",
    "demo:seed": "cd .. && docker exec -i supabase_db_mostfundable psql -U postgres -d postgres -v ON_ERROR_STOP=1 -q < supabase/seed.sql",
    "demo:reset:cloud": "cd .. && supabase db push --linked --include-seed",
    "demo:drain-analysis": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/demo-drain-analysis.mjs",
    "verify:referrals": "node scripts/verify-referrals-api.mjs",
    "verify:affiliates": "node scripts/verify-affiliates-api.mjs",
    "test:kb-boundaries": "node scripts/verify-kb-boundaries.mjs --self-test && node scripts/verify-kb-boundaries.mjs",
    "test:kb-api": "node scripts/verify-kb-api.mjs",
    "test:ancillary-types-scope": "node scripts/verify-ancillary-types-scope.mjs",
    "test:ancillary-api": "node scripts/verify-ancillary-api.mjs",
    "test:console-ops-api": "node scripts/verify-console-ops-api.mjs",
    "test:console-ops-types-scope": "node scripts/verify-console-ops-types-scope.mjs --self-test",
    "test:billing-ops-api": "node scripts/verify-billing-ops-api.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.25.0",
    "motion": "^12.42.2",
    "next": "16.3.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "stripe": "22.5.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "use-stick-to-bottom": "^1.1.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "shadcn": "^4.13.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
