# MostFundable — the environment contract. Key names only, no values, ever.
#
# Every line below is a comment or `NAME=` with nothing after the equals sign, and
# `node scripts/verify-env-contract.mjs --env-example` enforces exactly that. No value of any
# kind belongs in this file: not a real credential, not a fake one, not an example one. The
# local Supabase stack prints its demo keys through `supabase status -o env` — read them there
# and paste them into `.env.local`, which git ignores. Never into this file, which git tracks.
#
# Copy this to `.env.local` and fill in only what you actually need. A blank value counts as
# absent everywhere: `resolveDriver()` in `src/lib/env.ts` returns the mock or fixture driver,
# and `featureFlag()` returns false unless the value is explicitly 1, true, on or yes. So a
# verbatim copy boots the whole stack on mocks with every capability off — the same state as CI
# and as the deployed app today, which is the point of DEC-OWN-CREDLESS.
#
# Setting a driver selector to a driver whose keys are missing throws at boot rather than
# degrading to the mock, so set a selector and its keys together or leave both alone.
#
# The comments in this file are scanned by `node scripts/verify-compliance-copy.mjs`, on the same
# vocabulary rules as product copy, so a careless one fails the build.

# --- Supabase platform (the new project in Alec's "Legacy Strong HQ" org) --------------------

# Platform project URL, browser-readable. Local: the API_URL line of `supabase status -o env`.
NEXT_PUBLIC_SUPABASE_URL=
# Canonical spelling — BACKEND-SPEC §10 writes it unprefixed, but Next.js only inlines NEXT_PUBLIC_* names into the browser bundle, so the prefixed form is the one accepted spelling and there is no dual acceptance. Local: the ANON_KEY line of `supabase status -o env`.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only, never NEXT_PUBLIC (INTERFACES §3). Local: the SERVICE_ROLE_KEY line of `supabase status -o env`.
SUPABASE_SERVICE_ROLE_KEY=
# Server-only bearer secret used by the deployment scheduler to invoke the bounded job tick.
CRON_SECRET=
JOB_TICK_DEADLINE_MS=

# Local-only role accounts used by the Phase 2 provisioning and verification scripts.
AUTH_DEV_PLATFORM_ADMIN_EMAIL=
AUTH_DEV_PLATFORM_ADMIN_PASSWORD=
AUTH_DEV_OPERATOR_EMAIL=
AUTH_DEV_OPERATOR_PASSWORD=
AUTH_DEV_CONSUMER_EMAIL=
AUTH_DEV_CONSUMER_PASSWORD=
AUTH_DEV_AFFILIATE_EMAIL=
AUTH_DEV_AFFILIATE_PASSWORD=

# Local fee-gate sign-in variables. Set both to the fixed local-stack seed default in supabase/seed.sql; never reuse that test value elsewhere.
FEES_E2E_OWNER_PASSWORD=
FEES_E2E_ADMIN_PASSWORD=

# --- VAULT (the existing CCA funding brain, read through a nightly sync) ---------------------

# URL of the existing VAULT Supabase project. Required by VAULT_DRIVER=supabase.
VAULT_SUPABASE_URL=
# A key scoped to that one project, never the shared account-wide sbp_ access token. Required by VAULT_DRIVER=supabase.
# Held today (Aug 18) as VAULT's service_role key, which is read-write; the sync only needs SELECT and the
# write-back only needs INSERT on data_points, so treat the write-back path's blast radius as a code-review
# obligation in Phase 8 rather than something this credential prevents. See .planning/CLIENT-ASKS-AUDIT.md A9.
VAULT_SERVICE_KEY=

# --- CRS (monitoring embed and the server-side Data API) -------------------------------------

# CRS API base URL, from CRS via Alec/Kale. Required by CRS_DRIVER=sandbox.
CRS_BASE_URL=
# CRS API key, from CRS via Alec/Kale. Required by CRS_DRIVER=sandbox; absent means the CRS mock driver.
CRS_API_KEY=
# CRS API secret paired with CRS_API_KEY. Required by CRS_DRIVER=sandbox.
CRS_SECRET=
# Basic-auth user CRS presents on inbound webhooks. The webhook route fails closed when either
# half is unset; these portal-configured values do not control outbound sandbox client boot.
CRS_WEBHOOK_BASIC_USER=
# Basic-auth password CRS presents on inbound webhooks, configured per host in the CRS portal.
CRS_WEBHOOK_BASIC_PASS=
# Server-only high-entropy secret used to HMAC webhook/alert ids and encrypt the live alert fetch
# pointer. This value is never entered in CRS and must be at least 32 bytes.
CRS_ALERT_POINTER_SECRET=
# Provisional name for §10's "+ HMAC secret if granted" — unconfirmed for this account, so lane C renames it if and when CRS grants one.
CRS_WEBHOOK_HMAC_SECRET=
# Header CRS uses to carry the webhook signature. UNVERIFIED-FOR-ACCOUNT (CRS names none publicly); the code default is ours — set only when CRS names one. Owner: lane C (Phase 4).
CRS_WEBHOOK_HMAC_HEADER=
# Optional comma-separated allow-list of CRS webhook source IPs; unset skips the source check. Owner: lane C (Phase 4).
CRS_WEBHOOK_SOURCE_IPS=
# Sandbox HTTP request timeout in ms (positive integer); unset uses the code default. Owner: lane C (Phase 4).
CRS_HTTP_TIMEOUT_MS=
# "true" permits an http:// CRS_BASE_URL for LOCAL work only. Never set on main/production. Owner: lane C (Phase 4).
CRS_ALLOW_INSECURE_BASE_URL=
# Customer host key (UUID) the monitoring widget needs in its WIDGET_CONFIGS reply, from the CRS
# portal. Unset means the consumer credit panel embeds no widget at all and keeps the durable read.
CRS_WIDGET_HOST_KEY=
# Widget feature bitmask deciding which sections render inside the frame. Unset uses the provider
# default of zero. Set only a mask whose bits you can account for: this product does not show score
# projections, and CRS publishes no table of what the bits mean.
CRS_WIDGET_FLAGS=

# --- Stripe ----------------------------------------------------------------------------------

# Server-side secret key. Required by BILLING_DRIVER=stripe; the key's own prefix decides test or live mode, so there is no separate mode variable.
STRIPE_SECRET_KEY=
# One platform-level Stripe statement descriptor. Leave blank until the account-qualified value is approved.
STRIPE_STATEMENT_DESCRIPTOR=
# Signing secret for the Stripe webhook endpoint, used to verify every inbound event. Required by
# BILLING_DRIVER=stripe: without it the outbound half still creates subscriptions and charges while
# every inbound event is rejected, so nothing activates, cancels, dunns or attributes a refund.
STRIPE_WEBHOOK_SECRET=
# Publishable key for the browser payment element — public by design and already correctly prefixed in §10.
NEXT_PUBLIC_STRIPE_PK=

# --- Pricing placeholders (the placeholder is the decision, not a gap) -----------------------

# §10's wildcard spelling for the consumer monitoring price id. Nothing reads this name — the
# resolver reads CONSUMER_MONITORING_PRICE_REF below — and it is kept only so the §10 inventory
# stays discoverable from this file. Set the name the code reads, not this one.
STRIPE_PRICE_CONSUMER_MONITORING=
# Lane B's resolved monthly display and persisted amount in cents. Optional; defaults to the decided placeholder when absent.
CONSUMER_MONITORING_PRICE_CENTS=
# Lane B's mock/Stripe price reference. Required by BILLING_DRIVER=stripe: the resolver otherwise
# falls back to the mock monitoring reference, which only the mock driver honours, so a real
# subscription create would be rejected by the provider on first use.
CONSUMER_MONITORING_PRICE_REF=
# Stripe price id for the operator base plan. Required by BILLING_DRIVER=stripe, same reason as the
# monitoring reference. Provisional name — §10 writes _OPERATOR_* as a wildcard, and lane B confirms the split when the prices exist.
STRIPE_PRICE_OPERATOR_BASE=
# Stripe price id for the operator per-seat add-on. Required by BILLING_DRIVER=stripe. Provisional name, same reason and same owner as STRIPE_PRICE_OPERATOR_BASE.
STRIPE_PRICE_OPERATOR_SEAT=
# Operator base plan amount in cents. Optional; overrides orgs.base_price_cents, which itself overrides the decided placeholder.
OPERATOR_BASE_PRICE_CENTS=
# Operator per-seat amount in cents. Optional; overrides orgs.seat_price_cents, which itself overrides the decided placeholder.
OPERATOR_SEAT_PRICE_CENTS=
# How long an operator grace window stays open, in days. Optional; defaults to 7. Nothing expires a window on a timer — leaving grace still requires an event.
OPERATOR_GRACE_DAYS=
# One-off force-pull charge, in cents. Placeholder until the pricing session.
FORCE_PULL_PRICE_CENTS=
# Operator share of monitoring revenue, as a percent. Placeholder until the pricing session.
MONITORING_SPLIT_PCT=
# What the SaaS referral commission is calculated against. Placeholder until the pricing session.
SAAS_REFERRAL_BASE=

# --- Consumer referrals -------------------------------------------------------------------------

# Server-only UUID of the uniquely marked PLATFORM intake organization.
REFERRAL_PLATFORM_ORG_ID=
# Server-only canonical origin for referral landing and intake.
REFERRAL_INTAKE_ORIGIN=

# --- OpenRouter (zero-data-retention tier only) ----------------------------------------------

# OpenRouter API key, ZDR tier. Required by AI_DRIVER=openrouter.
OPENROUTER_API_KEY=
# Model slug used for plan and coach generation on the ZDR tier.
OPENROUTER_MODEL=
# Model slug for the compliance supervisor pass over generated copy. Provisional name — §10 abbreviates it as _SUPERVISOR_MODEL, and lane C confirms the full name when it wires the supervisor.
OPENROUTER_SUPERVISOR_MODEL=
# Confidence bar an AI support draft must reach before a person can send it, as a number between 0 and 1. Blank counts as absent and uses the code default. The resolved value is stored on each draft row, so history keeps the bar that actually applied. Owner: Phase 13.
SUPPORT_DRAFT_CONFIDENCE_THRESHOLD=

# --- Application -------------------------------------------------------------------------------

# There is one deployed environment (decision Aug 15), so the only value this takes is `production`. Leave it unset locally and on preview builds.
APP_ENV=
# Link to the trainings doc shown on the Platform trainings tab. Read server-side today; it carries the same prefix question as the anon key and rides with whatever Phase 2 decides for the flags below.
PLATFORM_TRAININGS_URL=
# Exact approved attestation copy. Leave blank until Ayman supplies it.
TRAINING_ATTESTATION_TEXT=
# Optional Northwest partner destination; an absent or invalid HTTPS URL renders nothing.
NORTHWEST_PARTNER_URL=

# --- Transactional email ----------------------------------------------------------------------

# Server-side Resend API key. Required only when EMAIL_DRIVER=resend.
RESEND_API_KEY=
# Platform-domain mailbox. The operator name is added as the display name at send time. Required by
# EMAIL_DRIVER=resend: the driver refuses to construct without it, and the failure surfaces as a
# generic failed job that retries to exhaustion rather than as a configuration error.
EMAIL_FROM_ADDRESS=

# Phase 20 tenancy fallback while no production wildcard domain exists. Leave blank to resolve the direct host.
DEFAULT_ORG_SLUG=
# Positive whole-day tenant trial length. Blank uses the lazy code default of 14.
TRIAL_DAYS=

# --- Feature flags (all twenty present, all OFF) -----------------------------------------------
#
# Every new capability ships OFF on `main` and is flipped on only after its acceptance pass; while
# a flag is off, the demo fixtures stay the fallback. These flags are read SERVER-SIDE today — a
# client component calling featureFlag() gets false unconditionally and logs an error saying so.
# How a flag reaches the browser is an open interface ask carried to Phase 2, and it is not
# answered here.

# Lane A — real Supabase authentication in place of the demo session.
FEATURE_REAL_AUTH=
# Lane B — consumer onboarding, the two named consents, e-signature and IDV, persisted.
FEATURE_ENROLLMENT=
# Lane C — server-side CRS Data API analysis and the derived funding plan.
FEATURE_ANALYSIS=
# Integration — the funding tracker surface reading live rows instead of fixtures.
FEATURE_TRACKER=
# Sprint 2 — live Stripe subscriptions and charges.
FEATURE_BILLING=
# Lane D — lender matches from the synced VAULT banks cache.
FEATURE_VAULT=
# Sprint 2 — the support and messaging surface.
FEATURE_SUPPORT=
# Sprint 2 — the applications and outcomes surface, and the outcome write-back to the funding brain.
FEATURE_APPLICATIONS=
# Sprint 2 — the fee models and the receivables ledger. Off unless this is `true`. It does not open the package-model legal gate, which is a database fact and is never set by an environment value.
FEATURE_FEES=
# Sprint 3 — consumer referral link creation, click, and conversion state.
FEATURE_REFERRALS=
# Sprint 3 — monitoring-share and SaaS-referral ledgers plus their platform KPI reads.
FEATURE_REVENUE=
# Sprint 3 — knowledge-base import and grounded answer surfaces.
FEATURE_KB=
# Sprint 3 — trainings, uploads, notifications, exports, and pull caps. Off unless explicitly enabled.
FEATURE_ANCILLARY=
# Sprint 3 — paid force-pull enqueue and runtime pricing displays. Off unless explicitly enabled.
FEATURE_PAID_REFRESH=
# Conversation timeline reads plus operator document request and review writes. Off unless explicitly enabled.
FEATURE_TIMELINE=
# Sprint 3b — tracker health/archive and training re-attestation/takedown evidence.
FEATURE_CONSOLE_OPS=
# Sprint 3b — the operator card-failure email queue and dispatch path. Off unless explicitly enabled.
FEATURE_EMAIL=
# Sprint 3b — live affiliate attribution and the limited affiliate portal view. Off unless explicitly enabled.
FEATURE_AFFILIATES=
# Sprint 3b — governed admin settings, KPI snapshots, prompt versions, and evaluator history.
FEATURE_ADMIN=
# Sprint 3b — tenant resolution, provisioning, invitations, billing wall, and Brand Studio.
FEATURE_TENANCY=
# Sprint 3b — client caps, hosted billing sessions, settlement, and refund netting.
FEATURE_BILLING_OPS=
# Demo convenience, not a product slice — with FEATURE_REAL_AUTH also on, /sign-in offers one
# button per demo role that signs that role's seeded account in. Anyone who can reach the page
# with this on can sign in as the platform admin, so it stays off for anything real.
FEATURE_DEMO_QUICK_SIGN_IN=
# Password for the seeded demo accounts the button above signs in. Server-only: it is read in the
# route handler and never reaches the browser. Unset disables the buttons even when the flag is on.
DEMO_QUICK_SIGN_IN_PASSWORD=

# --- Driver selectors (INTERFACES §10, frozen) -------------------------------------------------
#
# One selector per service, read once at that service's module load. Leave a selector blank to get
# the default driver named below. An explicit selector whose driver is missing a required key
# throws at boot instead of degrading to the mock, and a value outside the listed set throws too,
# so a typo cannot quietly change behaviour on `main`. Setting the key alone does not switch a
# driver — set the selector too. Adding a driver or a value is an interface ask, not an edit.

# mock | sandbox — default mock. sandbox also needs CRS_BASE_URL, CRS_API_KEY and CRS_SECRET.
# Inbound webhook Basic auth remains independently fail-closed. Owner: lane C.
CRS_DRIVER=
# mock | stripe — default mock. stripe also needs STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET,
# CONSUMER_MONITORING_PRICE_REF, STRIPE_PRICE_OPERATOR_BASE and STRIPE_PRICE_OPERATOR_SEAT.
# Owner: lane B.
BILLING_DRIVER=
# mock | crs — default mock. crs requires CRS_DRIVER=sandbox plus the three outbound CRS values.
IDV_DRIVER=
# DEPRECATED, and read for one more release only. AI_DRIVER used to select the driver for four
# services at once — the plan engine, the assistants, support drafts and the admin eval policy — so
# flipping it for one of them silently reconfigured the others; that is what broke every production
# analysis run on 2026-08-22. Each service now has its own key below (PLAN_DRIVER was split first).
# While a service's own key is blank and this one is set, this one still supplies its value and the
# service logs one warning naming the key to move to. Set the three keys below and clear this one.
AI_DRIVER=
# mock | openrouter — default mock. openrouter also needs OPENROUTER_API_KEY. Selects where the
# funding coach and the four KB assistant operations get their answers. The model, reasoning effort
# and provider ordering stay on the KB_* keys above; this chooses the driver and nothing else.
ASSISTANT_DRIVER=
# mock | openrouter — default mock. openrouter also needs OPENROUTER_API_KEY. Selects the driver
# behind support draft generation, over the same zero-data-retention transport. Drafts are never
# sent by the machine on either arm — a person sends, always (SUPP-01, DEC-D10).
SUPPORT_DRAFT_DRIVER=
# mock | openrouter — default mock. openrouter also needs OPENROUTER_API_KEY. Decides whether an
# admin prompt activation's evaluation runs count: on mock the activation is held as
# launch_driver_unavailable. Set it to openrouter only alongside the driver of the prompt's own
# service (PLAN_DRIVER for funding-readiness-plan, SUPPORT_DRAFT_DRIVER for support-draft) — an
# evaluation whose driver disagrees with the identity it records is refused rather than recorded.
EVAL_DRIVER=
# mock | openrouter — default mock. openrouter also needs OPENROUTER_API_KEY. The plan engine's own
# key, chosen once at module load. Leave it on mock until the plan contract can survive a real
# model: evaluatePlan recomputes every field it checks and demands an exact reproduction.
PLAN_DRIVER=
# fixture | supabase — default fixture. supabase also needs VAULT_SUPABASE_URL and VAULT_SERVICE_KEY. Owner: lane D.
VAULT_DRIVER=
# fixture | vault_supabase — default fixture. NOT part of the frozen §10 table; the KB source keeps
# its own selector so that flipping VAULT_DRIVER cannot reconfigure the weekly KB reimport (G-KB-01).
# vault_supabase also needs VAULT_SUPABASE_URL and VAULT_SERVICE_KEY, and still refuses with
# KB_SOURCE_SHAPE_UNVERIFIED until the VAULT KB tables are verified against the SourceArticle shape.
KB_SOURCE_DRIVER=
# hash64 | llm_score — default hash64, which is a 64-bucket lexical hash of the question's tokens
# and therefore only reaches an article phrased in roughly the article's own words. llm_score ranks
# the candidates by a model's stated relevance over the same ZDR transport the answers use, and also
# needs OPENROUTER_API_KEY. NOT part of the frozen §10 table; retrieval keeps its own selector so
# that AI_DRIVER, VAULT_DRIVER and KB_SOURCE_DRIVER cannot reconfigure it. Any provider failure on
# llm_score degrades to the hash64 ranking rather than to an error, so a flip is reversible by
# clearing this key and redeploying, and needs no reimport — stored article embeddings are unchanged.
KB_EMBEDDING_DRIVER=
# Optional (F-10). The model the four KB assistant operations talk to. Leave blank for the
# transport default, which is the OPENROUTER_MODEL constant in llm/chat-transport.ts — note that
# the OPENROUTER_MODEL *variable* below is read by nothing and never has been, so this is the only
# key that moves the KB off that constant. A malformed value throws rather than silently keeping
# the default. The default stays the current model on purpose: no candidate's latency, strict
# json_schema support or ZDR availability has been measured on the live account, and a faster
# unverified default is not an improvement. gpt-oss-120b is a reasoning model and a consumer answer
# is two sequential supervised calls, which is where the ~30s goes.
KB_ANSWER_MODEL=
# Optional (F-10). The scoring model for KB_EMBEDDING_DRIVER=llm_score only. Falls back to
# KB_ANSWER_MODEL, then to the transport default. Move this one first when tuning: a scoring model
# that misbehaves degrades to the hash ranking and logs KB_RETRIEVAL_DEGRADED, while an answer model
# that misbehaves means no answer on a surface that is live behind FEATURE_KB.
KB_SCORING_MODEL=
# Optional (F-10). low (default) | off. low is the floor for the gpt-oss family and the right
# setting for the current model. off omits the reasoning block entirely, and exists so the two model
# keys above are usable at all: provider.require_parameters is true, so sending reasoning to a model
# that does not reason can empty the provider set and fail the request. NOT a speed setting — on a
# reasoning model, omitting the block hands the effort choice to the provider's default, which is
# HIGHER than low. Set it only alongside a non-reasoning model.
KB_REASONING=
# Optional. throughput (default) | latency | price. Which ZDR provider OpenRouter tries first for a
# KB call; every other part of the request (ZDR, data_collection deny, strict json_schema) is the
# same on every arm. price is the old behaviour — load-balanced by price, which for gpt-oss-120b
# means the slow endpoints. Measured on the deployment 2026-08-24; a value outside the list throws.
KB_PROVIDER_SORT=
# fixture | unavailable — default fixture. unavailable is the explicit fail-closed parser arm.
CREDIT_REPORT_PARSER_DRIVER=
# mock | resend — default mock. resend also needs RESEND_API_KEY and EMAIL_FROM_ADDRESS. Owner: Phase 25.
EMAIL_DRIVER=

# --- Build --------------------------------------------------------------------------------------

# Shadcnblocks registry key, used only when pulling blocks at build time. Its placeholder value was blanked in task S1.0 because this file carries names and nothing else.
SHADCNBLOCKS_API_KEY=
